{
  // Run from /home/dev/ws inside the container. Each ROS task sources ROS 2
  // and the prebuilt overlay itself, so it works no matter which environment
  // the VS Code server was started with.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon: build",
      "detail": "RelWithDebInfo + compile_commands.json for C/C++ IntelliSense",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && source /opt/overlay_ws/install/setup.bash && colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
      "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "/bin/bash", "args": ["-c"] } },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$gcc"
    },
    {
      "label": "colcon: test",
      "type": "shell",
      "command": "source /opt/ros/humble/setup.bash && source /opt/overlay_ws/install/setup.bash && colcon test && colcon test-result --verbose",
      "options": { "cwd": "${workspaceFolder}", "shell": { "executable": "/bin/bash", "args": ["-c"] } },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "rosdep: install workspace dependencies",
      "type": "shell",
      "command": "sudo apt-get update && rosdep install --from-paths src --ignore-src -r -y",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "colcon: clean",
      "type": "shell",
      "command": "rm -rf build install log",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
